# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena los valores.
# El `.env` real NUNCA se sube a git.

# Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
NEXT_PUBLIC_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Sólo backend (scripts y server actions). NO se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# Aurellano API ----------------------------------------------------------
# Backend del catálogo (Neon Postgres + Cloudinary).
NEXT_PUBLIC_AURELLANO_API="https://aurellano-api.srv1124642.hstgr.cloud"

# API key para mutaciones. SERVER-ONLY (Server Actions / Route Handlers).
# Pídesela a tu socio por canal seguro (1Password, Signal). Nunca en cliente.
ADMIN_API_KEY=""

# Analítica ----------------------------------------------------------------
# ID del contenedor de Google Tag Manager (formato GTM-XXXXXXX).
# GTM solo se carga tras aceptación de cookies en el banner de consentimiento
# (ver src/components/consent/). Sin este valor, no se carga ningún script.
NEXT_PUBLIC_GTM_ID=""
