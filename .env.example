# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena los valores.
# El `.env` real NUNCA se sube a git.

# Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
NEXT_PUBLIC_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Sólo backend (scripts y server actions). NO se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# Catálogo ------------------------------------------------------------------
# El catálogo vive en Supabase (tablas catalog_*), servido por
# src/lib/pim/catalog-backend.ts. CATALOG_BACKEND=api vuelve a usar la API
# antigua de la VPS (solo emergencias, mientras exista).
CATALOG_BACKEND=""

# Fotos de producto: el admin las sube directamente a Cloudinary. SERVER-ONLY.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# API antigua (VPS + Neon). Solo se usa con CATALOG_BACKEND=api; la URL además
# sirve de prefijo interno de las rutas del catálogo.
NEXT_PUBLIC_AURELLANO_API="https://aurellano-api.srv1124642.hstgr.cloud"
ADMIN_API_KEY=""

# Analítica ----------------------------------------------------------------
# ID del contenedor de Google Tag Manager (formato GTM-XXXXXXX).
# GTM solo se carga tras aceptación de cookies en el banner de consentimiento
# (ver src/components/consent/). Sin este valor, no se carga ningún script.
NEXT_PUBLIC_GTM_ID=""
